<?xml version="1.0" encoding="utf-8"?>
<RevitAddIns>
  <!-- 1. Ứng dụng chính HDTOOL (Ribbon Tab HDTOOL & các công cụ) -->
  <AddIn Type="Application">
    <Name>HDTOOL</Name>
    <Assembly>HDTOOL\HDTOOL.dll</Assembly>
    <FullClassName>HDTool.App</FullClassName>
    <ClientId>B7C59E12-4C10-4A82-96DE-57C894EF31A0</ClientId>
    <VendorId>HDTOOL</VendorId>
    <VendorDescription>HDTOOL BIM Development</VendorDescription>
  </AddIn>

  <!-- 2. Lệnh Căn Chỉnh Grids Mặt Bằng & Sheet (Người dùng tự chọn) -->
  <AddIn Type="Command">
    <Name>HDTOOL - Căn Chỉnh Grids</Name>
    <Assembly>HDTOOL\HDTOOL.dll</Assembly>
    <FullClassName>HDTool.GridCropCommand</FullClassName>
    <ClientId>E1F30C4D-2374-4C75-A8F8-690DF27E1C38</ClientId>
    <VendorId>HDTOOL</VendorId>
    <VendorDescription>HDTOOL BIM Development</VendorDescription>
  </AddIn>

  <!-- 3. Lệnh Căn Chỉnh Level Mặt Cắt, Đứng & Sheet (Người dùng tự chọn) -->
