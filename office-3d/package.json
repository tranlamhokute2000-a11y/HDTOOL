{
  "name": "office-3d",
  "version": "1.0.0",
  "description": "Văn phòng Agent Revit 3D mô phỏng đội ngũ phát triển tool Revit theo thời gian thực",
  "type": "module",
  "scripts": {
    "server": "node server/index.js",
