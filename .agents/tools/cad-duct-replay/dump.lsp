(defun f (v) (rtos (float v) 2 4))
(defun lay (el) (cdr (assoc 8 el)))
(defun nz (el / n) (setq n (assoc 210 el)) (if n (cadddr n) 1.0))
(defun w (p el / n) (setq n (assoc 210 el)) (if n (trans p (cdr n) 0) p))
(defun dumpent (e / el tp s pts closed p0 p1 v vl)
  (setq el (entget e) tp (cdr (assoc 0 el)))
  (if (and (/= (cdr (assoc 60 el)) 1))
    (cond
      ((= tp "LINE")
        (write-line (strcat "L|" (lay el) "|" (f (car (cdr (assoc 10 el)))) "|" (f (cadr (cdr (assoc 10 el)))) "|" (f (car (cdr (assoc 11 el)))) "|" (f (cadr (cdr (assoc 11 el))))) out))
      ((= tp "LWPOLYLINE")
        (setq s "" closed (logand (cdr (assoc 70 el)) 1) vl nil v nil)
        (foreach d el
          (if (= (car d) 10) (setq v (w (list (cadr d) (caddr d) 0.0) el)))
          (if (= (car d) 42) (setq s (strcat s (f (car v)) "," (f (cadr v)) "," (rtos (* (cdr d) (if (< (nz el) 0) -1.0 1.0)) 2 6) ";"))))
        (write-line (strcat "P|" (lay el) "|" (itoa closed) "|" s) out))
      ((= tp "ARC")
        (write-line (strcat "A|" (lay el) "|" (f (car (cdr (assoc 10 el)))) "|" (f (cadr (cdr (assoc 10 el)))) "|" (f (cdr (assoc 40 el))) "|" (rtos (cdr (assoc 50 el)) 2 8) "|" (rtos (cdr (assoc 51 el)) 2 8) "|" (if (< (nz el) 0) "-1" "1")) out))
      ((= tp "INSERT")
        (setq p0 (cdr (assoc 10 el)))
        (write-line (strcat "I|" (lay el) "|" (cdr (assoc 2 el)) "|" (f (car p0)) "|" (f (cadr p0)) "|" (rtos (cdr (assoc 41 el)) 2 8) "|" (rtos (cdr (assoc 42 el)) 2 8) "|" (rtos (cdr (assoc 50 el)) 2 8) "|" (if (< (nz el) 0) "-1" "1")) out))
    )
  )
)
(setq out (open (strcat (getvar "DWGPREFIX") "lines.txt") "w"))
(setq r (tblnext "LAYER" T))
(while r
  (write-line (strcat "Y|" (cdr (assoc 2 r)) "|" (itoa (abs (cdr (assoc 62 r)))) "|" (itoa (cdr (assoc 70 r))) "|" (if (< (cdr (assoc 62 r)) 0) "OFF" "ON")) out)
  (setq r (tblnext "LAYER")))
(write-line "B|*MODEL|0|0" out)
(setq ss (ssget "X" '((410 . "Model"))) i 0)
(if ss (while (< i (sslength ss)) (dumpent (ssname ss i)) (setq i (1+ i))))
(setq r (tblnext "BLOCK" T))
(while r
  (setq nm (cdr (assoc 2 r)))
  (if (= 0 (logand (cdr (assoc 70 r)) 4))
    (progn
      (write-line (strcat "B|" nm "|" (f (car (cdr (assoc 10 r)))) "|" (f (cadr (cdr (assoc 10 r))))) out)
      (setq e (cdr (assoc -2 r)))
      (while e (dumpent e) (setq e (entnext e)))))
  (setq r (tblnext "BLOCK")))
(close out)
(princ "DUMPDONE")
(princ)
